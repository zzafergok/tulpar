# Tulpar Development Environment Variables
# Used automatically by `next dev` (override secrets locally in `.env.local`)

# Application URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_URL=http://localhost:3000

# Backend API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Authentication & Security
JWT_SECRET=tulpar-dev-only-jwt-secret-change-in-local
ALLOW_DEMO_AUTH=true
CRON_SECRET=tulpar-dev-cron-secret

# Firebase Configuration (Local / Demo Project)
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-tulpar.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-tulpar
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-tulpar.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000

# Firebase Local Emulator Suite (uncomment when running `firebase emulators:start`)
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
