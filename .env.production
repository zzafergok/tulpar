# Tulpar Production Environment Variables Template
# Used automatically by `next build` / `next start`
# IMPORTANT: Inject real secrets (JWT_SECRET, CRON_SECRET, FIREBASE_*) via your
# hosting provider / CI secret manager or `.env.production.local` (never commit real secrets).

# Application URLs
NEXT_PUBLIC_SITE_URL=https://your-domain.com
SITE_URL=https://your-domain.com

# Backend API Configuration
NEXT_PUBLIC_API_URL=https://your-domain.com/api

# Authentication & Security
# Generate with: openssl rand -base64 32
JWT_SECRET=replace-with-secure-random-jwt-secret
ALLOW_DEMO_AUTH=false
CRON_SECRET=replace-with-secure-random-cron-secret

# Firebase Configuration (Production Web App)
NEXT_PUBLIC_FIREBASE_API_KEY=your-prod-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-prod-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-prod-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-prod-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Firebase Admin SDK (Production Server Credentials)
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-prod-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Alternatively, pass full JSON or base64-encoded JSON:
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}
